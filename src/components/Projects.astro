---
import { projects } from '../data/profile';
const { t, lang } = Astro.props;
---

<section id="projects" class="mx-[var(--margin)] scroll-mt-24 border-t border-white/10 py-20 md:py-28">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="bp-kicker" data-fade-in>{t.projects.title}</p>
      <h2 class="smartText mt-5 max-w-xl font-display text-3xl font-light leading-tight sm:text-4xl" data-reveal>
        <span class="line"><span class="text">{t.projects.subtitle}</span></span>
      </h2>
    </div>
    <p class="font-mono text-xs text-[#b9b9b4]" data-fade-in style="--d:.15s">0{projects.length} · 2022—2026</p>
  </div>

  <!-- desktop: index table -->
  <div class="mt-12 hidden md:block">
    <div class="grid grid-cols-[90px_1.4fr_1fr_110px_90px] gap-6 border-b border-white/15 pb-3 font-mono text-[11px] uppercase tracking-[0.12em] text-[#b9b9b4]">
      <span>{lang === 'id' ? 'Tahun' : 'Year'}</span>
      <span>{lang === 'id' ? 'Proyek' : 'Project'}</span>
      <span>{lang === 'id' ? 'Peran · Stack' : 'Role · Stack'}</span>
      <span>{lang === 'id' ? 'Platform' : 'Platform'}</span>
      <span class="text-right">Link</span>
    </div>
    {projects.map((p) => (
      <a href={`/${lang}/projects/${p.slug}`} class="group grid grid-cols-[90px_1.4fr_1fr_110px_90px] items-center gap-6 border-b border-white/[0.08] py-6 transition-opacity duration-300 hover:opacity-60" data-fade-in-y>
        <span class="font-mono text-xs text-[#b9b9b4]">2024—25</span>
        <span class="font-display text-base text-[#f7f5f2]">{p.title}</span>
        <span class="font-mono text-xs text-[#b9b9b4]">{p.role[lang]} · {p.tech.slice(0, 2).join(', ')}</span>
        <span class="font-mono text-xs uppercase tracking-[0.08em] text-[#b9b9b4]">{p.tech[0]}</span>
        <span class="text-right font-mono text-xs text-[#c496ff]">View →</span>
      </a>
    ))}
  </div>

  <!-- mobile: cards -->
  <div class="mt-8 grid gap-8 md:hidden">
    {projects.map((p, i) => (
      <a href={`/${lang}/projects/${p.slug}`} class="block" data-fade-in-y style={`--d:${i * 0.06}s`}>
        <div class="aspect-[16/10] overflow-hidden rounded-xl border border-white/[0.06] bg-[#242424]">
          <img src={p.image} alt={p.title} width="800" height="500" class="h-full w-full object-cover" loading="lazy" />
        </div>
        <h3 class="mt-4 font-display text-lg text-[#f7f5f2]">{p.title}</h3>
        <p class="mt-1 font-mono text-[11px] uppercase tracking-[0.1em] text-[#c496ff]">{p.role[lang]}</p>
        <p class="mt-2 text-[13px] leading-relaxed text-[#b9b9b4]">{p.summary[lang]}</p>
      </a>
    ))}
  </div>
</section>
